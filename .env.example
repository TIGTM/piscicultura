DB_SERVER=database.example.internal
DB_PORT=3306
DB_USER=iefish_readonly
DB_PASSWORD=change-me
DB_NAME=iefish

HOST=127.0.0.1
PORT=3001

APP_SESSION_HOURS=12
# Opcional: caminho do arquivo persistente de senhas após a troca inicial.
