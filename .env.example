# API IEFish — Rastreabilidade 2.0. Nunca inclua credenciais em arquivos versionados.
IEFISH_API_BASE_URL=https://auth.iefishapp.com.br
IEFISH_API_COMPANY=estanciadatilapia
IEFISH_API_USERNAME=usuario-da-api
IEFISH_API_PASSWORD=troque-por-uma-senha-segura
